# ==============================================================================
# CommunityOTT Root .gitignore
# ==============================================================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
.env.local
*.env
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.cer
*.crt
credentials.json
secrets/
private/

# Xcode & Apple Development
build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xcuserdata
*.xccheckout
*.moved-aside
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# Backend Build & Package Outputs
**/target/
**/build/
**/out/
**/bin/
**/.gradle/
*.class
*.jar
*.war
*.ear

# Logs & Temporary Files
*.log
logs/
*.tmp
*.temp
temp/

# IDE & Editor Configuration
.idea/
.vscode/
*.swp
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Python & Analytics Service
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
