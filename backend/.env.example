# ===================================================================
# CommunityOTT Local Development Environment Variables Example
# Copy this file to .env before starting containers:
#   cp .env.example .env
# DO NOT INCLUDE REAL SECRETS IN THIS FILE
# ===================================================================

# PostgreSQL Configuration
POSTGRES_DB=communityott
POSTGRES_USER=communityott
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# MinIO (S3 Local Replacement) Configuration
MINIO_ROOT_USER=communityott
MINIO_ROOT_PASSWORD=change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=communityott-media
